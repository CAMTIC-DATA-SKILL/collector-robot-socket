# 이 파일을 .env 로 복사해서 쓴다. 비워 둔 값은 config.py 의 기본값을 따른다.

# 소켓 프레임 맵 JSON (저장소 루트 기준 상대경로 또는 절대경로)
SOCKET_MAP_FILE=socket_map.json

# 테스트베드 SCARA. 포트 5002, TCP Read CRLF, 최대 500바이트.
# VI 에 IP 상수는 없다. 현장 주소를 넣는다.
SOCKET_HOST=127.0.0.1
SOCKET_PORT=5002
SOCKET_TIMEOUT_SEC=30.0

# 수집 루프
POLL_INTERVAL_SEC=1.0
RECONNECT_INTERVAL_SEC=5.0

# 로깅: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 게이트웨이 IPC (ZeroMQ). data/health/ack PUB, cmd_r/cmd_w SUB
# 토픽: collector.robot.{DEVICE_KEY}.{msg_type}. DEVICE_KEY 에 '.' 금지
DEVICE_KEY=scara-1
GATEWAY_ADDRESS=gateway
# PUB 포트는 restapi(5558), modbus(5557), plc(5556) 와 겹치면 안 된다
ZMQ_PUB_ENDPOINT=tcp://127.0.0.1:5559
ZMQ_SUB_ENDPOINT=tcp://127.0.0.1:5555
ZMQ_PUB_BIND=true
ZMQ_SUB_BIND=false
ZMQ_RECV_TIMEOUT_MS=100
ZMQ_LINGER_MS=0
